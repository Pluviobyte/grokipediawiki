---
{
  "layout": "main",
  "title": "AI Toolbox",
  "description": "Collection of AI-powered tools for encyclopedia comparison and analysis",
  "path": "/tools/"
}
---

<section class="section pt-24">
  <div class="container">
    <div class="mx-auto max-w-3xl text-center mb-16">
      <h1 class="heading-1 mb-6">AI Toolbox</h1>
      <p class="text-lg text-muted-foreground">
        Powerful AI tools to help you compare and analyze encyclopedia entries
      </p>
    </div>

    <!-- Tools Grid -->
    <div class="grid gap-8 md:grid-cols-2">
      <!-- Tool 1 -->
      <div class="card p-8">
        <div class="mb-4 inline-flex h-14 w-14 items-center justify-center rounded-xl bg-primary/10 text-primary">
          <svg class="h-7 w-7" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </div>
        <h3 class="heading-3 mb-3">Entry Comparison Tool</h3>
        <p class="text-muted-foreground mb-6">
          Compare any topic between Grokipedia and Wikipedia side-by-side with AI-powered analysis.
        </p>
        <button class="btn btn-primary w-full">
          Coming Soon
        </button>
      </div>

      <!-- Tool 2 -->
      <div class="card p-8">
        <div class="mb-4 inline-flex h-14 w-14 items-center justify-center rounded-xl bg-primary/10 text-primary">
          <svg class="h-7 w-7" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
          </svg>
        </div>
        <h3 class="heading-3 mb-3">Source Verifier</h3>
        <p class="text-muted-foreground mb-6">
          Verify the credibility and reliability of sources cited in encyclopedia entries.
        </p>
        <button class="btn btn-primary w-full">
          Coming Soon
        </button>
      </div>

      <!-- Tool 3 -->
      <div class="card p-8">
        <div class="mb-4 inline-flex h-14 w-14 items-center justify-center rounded-xl bg-primary/10 text-primary">
          <svg class="h-7 w-7" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
          </svg>
        </div>
        <h3 class="heading-3 mb-3">Bias Detector</h3>
        <p class="text-muted-foreground mb-6">
          Analyze text for potential bias using advanced AI language models.
        </p>
        <button class="btn btn-primary w-full">
          Coming Soon
        </button>
      </div>

      <!-- Tool 4 -->
      <div class="card p-8">
        <div class="mb-4 inline-flex h-14 w-14 items-center justify-center rounded-xl bg-primary/10 text-primary">
          <svg class="h-7 w-7" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>
        <h3 class="heading-3 mb-3">Real-time Diff Tool</h3>
        <p class="text-muted-foreground mb-6">
          Track and visualize differences between article versions in real-time.
        </p>
        <button class="btn btn-primary w-full">
          Coming Soon
        </button>
      </div>

      <!-- Tool 5: MossAI Tools -->
      <div class="card p-8">
        <div class="mb-4 inline-flex h-14 w-14 items-center justify-center rounded-xl bg-green-500/10 text-green-600">
          <svg class="h-7 w-7" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
          </svg>
        </div>
        <h3 class="heading-3 mb-3">MossAI Tools</h3>
        <p class="text-muted-foreground mb-6">
          Advanced AI tools and utilities for enhanced productivity and analysis.
        </p>
        <a href="https://mossai.org"
           title="MossAI Tools"
           target="_blank"
           rel="noopener"
           class="btn btn-primary w-full">
          Visit MossAI Tools
          <svg class="ml-2 h-4 w-4 inline" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
