<!-- What is Grokipedia FAQ Section -->
<section class="section bg-gradient-to-br from-blue-50/50 to-cyan-50/50 dark:from-blue-950/10 dark:to-cyan-950/10">
  <div class="container">
    <div class="mx-auto max-w-4xl">
