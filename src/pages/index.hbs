    <!-- Mobile View All Link -->
    <div class="mt-8 text-center sm:hidden">
      <a href="/analysis/" class="link inline-flex items-center gap-2">
        View all analysis
        <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
        </svg>
      </a>
    </div>
  </div>
</section>

<!-- CTA Section -->
<section class="section bg-primary text-primary-foreground">
  <div class="container">
    <div class="mx-auto max-w-3xl text-center">
      <h2 class="heading-2 mb-4">Stay Updated with Latest Analysis</h2>
      <p class="text-lg mb-8 opacity-90">
        Get notified when we publish new comparative analysis and insights.
      </p>

      <!-- Newsletter Form -->
      <form data-form="newsletter" class="mx-auto max-w-md">
        <div class="flex flex-col sm:flex-row gap-3">
          <input
            type="email"
            name="email"
            placeholder="Enter your email"
            required
            class="input flex-1 bg-primary-foreground text-foreground"
          />
          <button type="submit" class="btn bg-primary-foreground text-primary hover:bg-primary-foreground/90 px-6">
            Subscribe
