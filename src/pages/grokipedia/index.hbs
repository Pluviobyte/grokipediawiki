<!-- Page‑level JSON‑LD (WebPage + Breadcrumb) -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebPage",
  "name": "{{page.title}}",
  "url": "{{url}}/grokipedia/",
  "inLanguage": "en-US",
  "description": "{{page.description}}",
  "primaryImageOfPage": {
    "@type": "ImageObject",
    "url": "{{url}}{{page.image}}",
    "width": 1200,
    "height": 630
  },
  "publisher": {
    "@type": "Organization",
    "name": "{{siteName}}",
    "url": "{{url}}",
    "logo": {
      "@type": "ImageObject",
      "url": "{{url}}{{logo}}",
      "width": 100,
      "height": 100
    }
  }
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {"@type": "ListItem", "position": 1, "name": "Home", "item": "{{url}}/"},
    {"@type": "ListItem", "position": 2, "name": "Groki Pedia", "item": "{{url}}/grokipedia/"}
  ]
}
</script>
