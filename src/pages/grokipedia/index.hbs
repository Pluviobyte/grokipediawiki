        <a href="/analysis/" class="btn btn-primary px-6 py-3">Read Deep Analysis</a>
        <a href="https://grok.com/" target="_blank" rel="noopener noreferrer" class="btn btn-outline px-6 py-3">Ask Grok</a>
      </div>
    </div>
  </div>
</section>

