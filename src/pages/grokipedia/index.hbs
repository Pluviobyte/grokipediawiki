<!-- How It Works -->
<section class="section">
  <div class="container">
    <div class="mx-auto max-w-4xl">
      <h2 class="heading-2 mb-6">How It Works</h2>
      <div class="grid gap-6 md:grid-cols-2">
        <div class="card p-6">
          <h3 class="heading-3 mb-2">1) Data Ingestion</h3>
          <p class="text-muted-foreground">Aggregates reference sources (encyclopedic data, academic literature, news, and verified public posts).</p>
        </div>
        <div class="card p-6">
          <h3 class="heading-3 mb-2">2) Analysis Engine</h3>
          <p class="text-muted-foreground">Classifies claims, detects gaps/missing context, and flags conflicts across sources.</p>
        </div>
        <div class="card p-6">
          <h3 class="heading-3 mb-2">3) Draft & Rewrite</h3>
          <p class="text-muted-foreground">Produces concise summaries, reduces weasel words, and surfaces core reasoning.</p>
        </div>
        <div class="card p-6">
          <h3 class="heading-3 mb-2">4) Fact Check</h3>
          <p class="text-muted-foreground">Cross‑references primary sources (e.g., filings, datasets) prior to publication.</p>
        </div>
        <div class="card p-6">
          <h3 class="heading-3 mb-2">5) Feedback Loop</h3>
          <p class="text-muted-foreground">Users submit corrections; AI triages and routes updates when validated.</p>
        </div>
      </div>
    </div>
  </div>
</section>

{{> ad-in-article}}

<!-- UI & Layout -->
<section class="section">
