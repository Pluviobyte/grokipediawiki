        <h2>API Integration Examples</h2>

        <h3>Python SDK</h3>
        <div class="bg-gray-900 text-gray-100 p-6 rounded-lg my-8 overflow-x-auto">
          <pre class="text-sm"><code>from openai import OpenAI

# xAI API is OpenAI-compatible
client = OpenAI(
    api_key="YOUR_API_KEY",
    base_url="https://api.x.ai/v1"
)

response = client.chat.completions.create(
    model="grok-2",
    messages=[
        {"role": "system", "content": "You are a helpful encyclopedia assistant."},
        {"role": "user", "content": "What is Grokipedia?"}
    ]
)

print(response.choices[0].message.content)</code></pre>
        </div>

        <h3>JavaScript/Node.js</h3>
        <div class="bg-gray-900 text-gray-100 p-6 rounded-lg my-8 overflow-x-auto">
          <pre class="text-sm"><code>import OpenAI from 'openai';

const client = new OpenAI({
  apiKey: process.env.XAI_API_KEY,
  baseURL: 'https://api.x.ai/v1'
});

async function askGrok(question) {
  const response = await client.chat.completions.create({
    model: 'grok-2',
    messages: [
      { role: 'user', content: question }
    ]
  });

  return response.choices[0].message.content;
}

askGrok('Explain machine learning').then(console.log);</code></pre>
