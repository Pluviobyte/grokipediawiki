<header class="sticky top-0 z-50 w-full border-b border-border/40 bg-background/95 backdrop-blur supports-[backdrop-filter]:bg-background/60">
  <div class="container flex h-16 items-center justify-between">
    <!-- Desktop Navigation -->
    <nav class="hidden lg:flex justify-between items-center w-full">
      <!-- Left: Logo & Navigation -->
      <div class="flex items-center gap-8">
        <!-- Logo -->
        <a href="/" class="flex items-center gap-2 hover:opacity-80 transition-opacity">
          <img src="{{logo}}" alt="{{siteName}} - Independent Encyclopedia Comparison Platform" class="h-8 w-auto" />
          <span class="text-xl font-bold text-primary">G.W.</span>
        </a>

        <!-- Navigation Links -->
        <ul class="flex items-center gap-6">
          {{#each nav}}
          <li>
            <a href="{{this.href}}"
               class="text-sm font-medium text-muted-foreground hover:text-primary transition-colors">
              {{this.label}}
            </a>
          </li>
          {{/each}}
        </ul>
      </div>

      <!-- Right: Actions -->
      <div class="flex items-center gap-2">
        <!-- Theme Toggle -->
        <button id="theme-toggle"
                class="inline-flex items-center justify-center rounded-md h-10 w-10 hover:bg-accent hover:text-accent-foreground transition-colors"
                aria-label="Toggle theme">
          <svg class="sun-icon h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <svg class="moon-icon hidden h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
        </button>

        <!-- CTA Button -->
        <a href="/analysis/"
           class="btn btn-primary px-4 py-2 text-sm">
          View Analysis
        </a>
      </div>
    </nav>

    <!-- Mobile: Logo & Menu Toggle -->
    <div class="flex lg:hidden w-full justify-between items-center">
      <!-- Mobile Logo -->
      <a href="/" class="flex items-center gap-2">
        <img src="{{logo}}" alt="{{siteName}} - Independent Encyclopedia Comparison Platform" class="h-7 w-auto" />
        <span class="text-lg font-bold text-primary">G.W.</span>
      </a>

      <!-- Mobile Menu Toggle -->
      <button id="mobile-menu-toggle"
              class="inline-flex items-center justify-center rounded-md h-10 w-10 hover:bg-accent"
              aria-label="Toggle mobile menu"
              aria-expanded="false">
        <svg class="hamburger-icon h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg class="close-icon hidden h-6 w-6" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Navigation Menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-border">
    <div class="container py-6 space-y-4">
      {{#each nav}}
      <a href="{{this.href}}"
         class="block py-2 text-base font-medium text-foreground hover:text-primary transition-colors">
        {{this.label}}
      </a>
      {{/each}}

      <div class="pt-4 border-t border-border space-y-3">
        <button id="mobile-theme-toggle"
                class="flex items-center gap-3 text-sm text-muted-foreground hover:text-primary transition-colors">
          <svg class="mobile-sun-icon h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>
          <svg class="mobile-moon-icon hidden h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
          </svg>
          <span class="theme-label">Toggle theme</span>
        </button>

        <a href="/analysis/"
           class="btn btn-primary w-full px-4 py-2 text-center">
          View Analysis
        </a>
      </div>
    </div>
  </div>
</header>
