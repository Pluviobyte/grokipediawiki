<footer class="border-t border-border bg-background">
  <div class="container py-12 md:py-16">
    <div class="flex flex-col lg:flex-row items-center lg:items-start justify-between gap-10 text-center lg:text-left">

      <!-- Left: Brand Info -->
      <div class="flex w-full max-w-sm flex-col items-center lg:items-start gap-6">
        <!-- Logo & Brand -->
        <div>
          <a href="/" class="flex items-center justify-center lg:justify-start gap-2 mb-4">
            <img src="{{logo}}" alt="{{siteName}} Logo - Encyclopedia Analysis Platform" class="h-10 w-auto" />
            <span class="text-2xl font-bold text-primary">Grokipedia Wiki</span>
          </a>
          <p class="text-sm text-muted-foreground max-w-xs">
            Independent third-party analysis platform providing objective comparisons between Grokipedia and Wikipedia.
          </p>
        </div>

        <!-- Social Links -->
        <div class="flex items-center gap-4">
          {{#if social.twitter}}
          <a href="{{social.twitter}}"
             target="_blank"
             rel="noopener noreferrer"
             class="text-muted-foreground hover:text-primary transition-colors"
             aria-label="Twitter">
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
          </a>
          {{/if}}

          {{#if social.github}}
          <a href="{{social.github}}"
             target="_blank"
             rel="noopener noreferrer"
             class="text-muted-foreground hover:text-primary transition-colors"
             aria-label="GitHub">
            <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
              <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
            </svg>
          </a>
          {{/if}}
        </div>
      </div>

      <!-- Right: Navigation Groups -->
      <div class="grid grid-cols-2 md:grid-cols-3 gap-8 md:gap-12">
        <!-- Column 1: Resources -->
        <div>
          <h3 class="font-semibold text-foreground mb-4">Resources</h3>
          <ul class="space-y-3 text-sm">
            <li><a href="/analysis/" class="text-muted-foreground hover:text-primary transition-colors">Deep Analysis</a></li>
            <li><a href="/news/" class="text-muted-foreground hover:text-primary transition-colors">News Center</a></li>
            <li><a href="/tools/" class="text-muted-foreground hover:text-primary transition-colors">AI Toolbox</a></li>
          </ul>
        </div>

        <!-- Column 2: Company -->
        <div>
          <h3 class="font-semibold text-foreground mb-4">Company</h3>
          <ul class="space-y-3 text-sm">
            <li><a href="/about/" class="text-muted-foreground hover:text-primary transition-colors">About Us</a></li>
            <li><a href="/about/#methodology" class="text-muted-foreground hover:text-primary transition-colors">Methodology</a></li>
            <li><a href="/about/#contact" class="text-muted-foreground hover:text-primary transition-colors">Contact</a></li>
          </ul>
        </div>

        <!-- Column 3: Legal -->
        <div>
          <h3 class="font-semibold text-foreground mb-4">Legal</h3>
          <ul class="space-y-3 text-sm">
            <li><a href="/privacy/" class="text-muted-foreground hover:text-primary transition-colors">Privacy Policy</a></li>
            <li><a href="/terms/" class="text-muted-foreground hover:text-primary transition-colors">Terms of Service</a></li>
            <li><a href="/disclaimer/" class="text-muted-foreground hover:text-primary transition-colors">Disclaimer</a></li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Bottom: Copyright -->
    <div class="mt-12 pt-8 border-t border-border flex flex-col md:flex-row items-center justify-between gap-4 text-sm text-muted-foreground">
      <p class="text-center md:text-left">
        © {{year}} Grokipedia Wiki. All rights reserved.
      </p>

      <p class="text-center md:text-right">
        Independent analysis platform • Not affiliated with Grokipedia or Wikipedia
      </p>
    </div>
  </div>
</footer>
